      "text_color": "#fff"
    },
    "docs": "A Plan is a pointer to an implementation plan document on disk. Usually descends from a Spec (`spec_ref`). Pattern-agnostic — DNA tracks pointer + metadata + refs, not the structure of the plan itself."
  },
  "flags": {
    "plane": "record",
    "scope": "global",
    "scope_declared": true,
    "is_prompt_target": false,
    "flatten_in_context": false,
    "prompt_target_priority": 0,
    "is_root": false,
    "is_runtime_artifact": false,
    "is_schema_affecting": false,
