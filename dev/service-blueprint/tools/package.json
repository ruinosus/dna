{
  "name": "service-blueprint-tools",
  "private": true,
  "type": "module",
  "description": "Builds the generated parts of the service-blueprint skill (the engine and the map page), and checks and packs the skill.",
  "scripts": {
    "assets": "node assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node check.mjs",
    "zip": "node zip.mjs",
    "site": "node site.mjs",
    "linux": "node linux-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@ruinosus/visual-explainer": "*",
    "esbuild": "0.24.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "yaml": "2.6.1"
  }
}
