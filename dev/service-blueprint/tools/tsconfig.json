{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        ".lib/node_modules/@types/react"
      ],
      "react/*": [
        ".lib/node_modules/@types/react/*"
      ],
      "@lib/*": [
        ".lib/*"
      ],
      "@kit/*": [
        "../../../node_modules/chalk-talk/kit/*"
      ],
      "*": [
        "../../../node_modules/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "../src/**/*.ts",
    "../checks/*.ts"
  ]
}
