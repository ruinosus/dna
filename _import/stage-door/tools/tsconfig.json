{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "typeRoots": [".engine/node_modules/@types"],
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": [".engine/*"],
      "yaml": [".engine/node_modules/yaml"],
      "zod": [".engine/node_modules/zod"],
      "*": [".engine/node_modules/*", ".engine/node_modules/@types/*"]
    }
  },
  "include": ["map/*.ts"]
}
