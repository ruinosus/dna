{
  "name": "back-of-napkin-tools",
  "private": true,
  "type": "module",
  "description": "Brings chalk-talk's engine into the back-of-napkin skill, and checks, packs and shows it.",
  "scripts": {
    "assets": "node assets.mjs",
    "check": "node check.mjs",
    "zip": "node zip.mjs",
    "site": "node site.mjs",
    "linux": "node linux-check.mjs",
    "audit": "node node_modules/chalk-talk/kit/tools/audit.mjs .. --skip npm/scripts --skip npm/assets --skip skills/back-of-napkin/assets --skip skills/back-of-napkin/scripts/contract.mjs --skip skills/back-of-napkin/scripts/engine-build.mjs --skip docs/drawings",
    "metrics": "node node_modules/chalk-talk/kit/tools/eval-metrics.mjs"
  },
  "devDependencies": {
    "chalk-talk": "^0.18.0"
  }
}
