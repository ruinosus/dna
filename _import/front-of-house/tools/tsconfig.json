{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@lib/*": [".lib/*"], "@kit/*": ["node_modules/chalk-talk/kit/*"], "*": ["node_modules/*"] }
  },
  "include": ["../src/**/*.ts", "../checks/*.ts"]
}
