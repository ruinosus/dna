{
  "name": "chalk-talk",
  "version": "0.17.2",
  "description": "Hand-drawn lessons that draw themselves: a player for chalk-talk recipes (one script for the browser or a CDN), a lesson you can mount inside any element, and a command that checks a recipe and builds one HTML file.",
  "license": "MIT",
  "type": "module",
  "author": "ruinosus",
  "homepage": "https://ruinosus.github.io/chalk-talk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruinosus/chalk-talk.git",
    "directory": "npm"
  },
  "bugs": "https://github.com/ruinosus/chalk-talk/issues",
  "keywords": [
    "agent-skills",
    "chalk-talk",
    "claude",
    "docusaurus",
    "education",
    "explainer",
    "hand-drawn",
    "lesson",
    "markdown-it",
    "mermaid",
    "remark",
    "svg"
  ],
  "bin": {
    "chalk-talk": "scripts/build.mjs"
  },
  "files": [
    "player.js",
    "embed.js",
    "embed.d.ts",
    "embed-mermaid.js",
    "embed-mermaid.d.ts",
    "mount.js",
    "mount.d.ts",
    "mount.global.js",
    "markdown.js",
    "markdown.d.ts",
    "scripts/",
    "kit/",
    "references/",
    "assets/player.html",
    "assets/lottie/",
    "assets/lottie_light.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./player.js",
    "./player.js": "./player.js",
    "./embed": {
      "types": "./embed.d.ts",
      "default": "./embed.js"
    },
    "./embed-mermaid": {
      "types": "./embed-mermaid.d.ts",
      "default": "./embed-mermaid.js"
    },
    "./package.json": "./package.json",
    "./mount": {
      "types": "./mount.d.ts",
      "default": "./mount.js"
    },
    "./mount.global.js": "./mount.global.js",
    "./markdown": {
      "types": "./markdown.d.ts",
      "default": "./markdown.js"
    },
    "./kit/*": "./kit/*"
  }
}
