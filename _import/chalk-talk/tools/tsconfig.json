{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@engine/*": [".engine/drawing/*"], "roughjs/*": [".engine/node_modules/roughjs/*"], "roughjs": [".engine/node_modules/roughjs"] }
  },
  "include": ["player/*.ts"]
}
