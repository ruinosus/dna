# from: assistant-delivery.way.yaml@0b224276
# Derivado de assistant-delivery.way.yaml pelo way-of-working --lens.
# bet: os volumes, os tempos e o tamanho das equipes são apostas: troque pelos seus.
sim "Entrega de um assistente"
lang en
horizon 3 months
seed 1

arrive item 5/week   # bet: 5 items a week
pool po $po shift 8h/day days mon-fri
pool dev $dev shift 8h/day days mon-fri
pool qa $qa shift 8h/day days mon-fri

step triagem by po time ~4h   # bet: «Triagem» takes about 4h of work
step construcao by dev time ~4h   # bet: «Construção» takes about 4h of work
step avaliacao by qa time ~4h   # bet: «Avaliação» takes about 4h of work
step acerto_gate by qa time ~1h   # bet: deciding «Acerto ≥ 85%?» takes about 1h
step publicacao by dev time ~4h   # bet: «Publicação» takes about 4h of work

end delivered

triagem -> construcao
construcao -> avaliacao
avaliacao -> acerto_gate
acerto_gate ->
  construcao $acerto_gate_nao
  publicacao rest
publicacao -> delivered

knob acerto_gate_nao 0%..90% = 20%   # bet: «Acerto ≥ 85%?» says «Não» to 20%
knob po 1..20 = 3   # bet: 3 people as Product Owner
knob dev 1..20 = 3   # bet: 3 people as Desenvolvimento
knob qa 1..20 = 3   # bet: 3 people as Qualidade
scenario "Mais um Product Owner": po = 4
scenario "Mais um Desenvolvimento": dev = 4
scenario "Mais um Qualidade": qa = 4

show count end delivered
show wait p90 at acerto_gate
show utilization po
show utilization dev
show utilization qa

labels en:
  item: Item
  po: Product Owner
  dev: Desenvolvimento
  qa: Qualidade
  triagem: Triagem
  construcao: Construção
  avaliacao: Avaliação
  publicacao: Publicação
  acerto_gate: Acerto ≥ 85%?
  delivered: Delivered
  acerto_gate_nao: Acerto ≥ 85%?: Não
labels pt-BR:
  item: Item
  po: Product Owner
  dev: Desenvolvimento
  qa: Qualidade
  triagem: Triagem
  construcao: Construção
  avaliacao: Avaliação
  publicacao: Publicação
  acerto_gate: Acerto ≥ 85%?
  delivered: Entregue
  acerto_gate_nao: Acerto ≥ 85%?: Não
