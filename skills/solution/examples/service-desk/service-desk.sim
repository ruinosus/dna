# from: service-desk.way.yaml@52832ab3
# Derivado de service-desk.way.yaml pelo way-of-working --lens.
# bet: os volumes, os tempos e o tamanho das equipes são apostas: troque pelos seus.
sim "Central de atendimento"
lang en
horizon 3 months
seed 1

arrive item 5/week   # bet: 5 items a week
pool cli $cli shift 8h/day days mon-fri
pool at $at shift 8h/day days mon-fri
pool sup $sup shift 8h/day days mon-fri
pool esp $esp shift 8h/day days mon-fri

step registrar by cli time ~4h   # bet: «Registrar o pedido» takes about 4h of work
step triar by at time ~4h   # bet: «Triagem» takes about 4h of work
# wip 10 in the way: the team's limit of items at once; here the team's size sets it
step resolver by at time ~4h   # bet: «Resolver no primeiro nível» takes about 4h of work
step escalar by sup time ~1h   # bet: deciding «Resolvido no primeiro nível?» takes about 1h
step investigar by esp time ~4h   # bet: «Investigar» takes about 4h of work
step confirmar by cli time ~4h   # bet: «Confirmar com o cliente» takes about 4h of work
step encerrar by cli time ~1h   # bet: deciding «Pode encerrar?» takes about 1h
step medir by sup time ~4h   # bet: «Medir a satisfação» takes about 4h of work

end delivered

registrar -> triar
triar -> resolver
resolver -> escalar
escalar ->
  investigar $escalar_nao
  confirmar rest
investigar -> confirmar
confirmar -> encerrar
encerrar ->
  triar $encerrar_nao
  medir rest
medir -> delivered

knob escalar_nao 0%..90% = 20%   # bet: «Resolvido no primeiro nível?» says «Escalar» to 20%
knob encerrar_nao 0%..90% = 20%   # bet: «Pode encerrar?» says «Reabrir» to 20%
knob cli 1..20 = 3   # bet: 3 people as Cliente
knob at 1..20 = 3   # bet: 3 people as Atendente
knob sup 1..20 = 3   # bet: 3 people as Supervisor de atendimento
knob esp 1..20 = 3   # bet: 3 people as Especialista
scenario "Mais um Cliente": cli = 4
scenario "Mais um Atendente": at = 4
scenario "Mais um Supervisor de atendimento": sup = 4
scenario "Mais um Especialista": esp = 4

show count end delivered
show wait p90 at escalar
show wait p90 at encerrar
show utilization cli
show utilization at
show utilization sup
show utilization esp

labels en:
  item: Item
  cli: Cliente
  at: Atendente
  sup: Supervisor de atendimento
  esp: Especialista
  registrar: Registrar o pedido
  triar: Triagem
  resolver: Resolver no primeiro nível
  investigar: Investigar
  confirmar: Confirmar com o cliente
  medir: Medir a satisfação
  escalar: Resolvido no primeiro nível?
  encerrar: Pode encerrar?
  delivered: Delivered
  escalar_nao: Resolvido no primeiro nível?: Escalar
  encerrar_nao: Pode encerrar?: Reabrir
  investigar_share: Investigar
labels pt-BR:
  item: Item
  cli: Cliente
  at: Atendente
  sup: Supervisor de atendimento
  esp: Especialista
