[project]
name = "{{ service_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.12,<3.14"

# Every runtime dependency is DECLARED HERE — nothing is pip-installed ad-hoc
# in the Dockerfile. The floor/ceiling pair is the contract with the SDK; a
# stale CEILING makes the resolver ignore a new release in silence, which is
# why both are answers and not template text.
dependencies = [
    "dna-cli[api]>={{ dna_floor }},<{{ dna_ceiling }}",
    "dna-sdk[postgres]>={{ dna_floor }},<{{ dna_ceiling }}",
{%- if identity != "none" %}
    "fastmcp>=3.4",
{%- endif %}
{%- if graph_obo | default(false) %}
    "msal>=1.28",
{%- endif %}
    "uvicorn[standard]>=0.30",
]

[project.optional-dependencies]
dev = ["pytest>=8"]

[project.scripts]
{{ service_name }} = "{{ python_module }}.server:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ python_module }}"]
