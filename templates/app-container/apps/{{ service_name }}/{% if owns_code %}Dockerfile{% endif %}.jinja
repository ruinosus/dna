# {{ service_name }} — built from THIS app's own package, never from a shared
# infra Dockerfile: the version floor lives in pyproject.toml, and a build that
# installed it anywhere else would make the declared floor a lie.
#
# ⚠️ This file exists only because {{ service_name }} OWNS the code
# (`owns_code: true`). N services can run this ONE image — the identity doors
# are three services over one image — and each of them renders its own wiring
{%- if ingress == 'none' %}
# with its own sleep answer.
#
# ⭐ `ingress: none` — {{ service_name }} does NOT serve. This image binds
# nothing and EXPOSEs nothing: there is no port here to bake a default for,
# and an EXPOSE would document a door that does not exist.
{%- else %}
# with its own port and its own sleep answer. So the {{ env_prefix }}_PORT
# baked in below is a DEFAULT for the image, not the truth about any service:
# the container app and the compose fragment set it per service, and they win.
{%- endif %}
FROM python:3.12-slim AS base

LABEL org.opencontainers.image.title="{{ service_name }}" \
      org.opencontainers.image.description="{{ description }}"

ENV PYTHONUNBUFFERED=1 \
{%- if ingress == 'none' %}
    PIP_NO_CACHE_DIR=1
{%- else %}
    PIP_NO_CACHE_DIR=1 \
    {{ env_prefix }}_HOST=0.0.0.0 \
    {{ env_prefix }}_PORT={{ port }}
{%- endif %}

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .
{% if ingress != 'none' %}
EXPOSE {{ port }}
{% endif %}
CMD ["{{ service_name }}"]
