sim "Admission document review"
lang en
horizon 1 month
currency USD

arrive document 1200/day peak mon x1.4
pool reviewers $reviewers shift 12h/day cost 3000/month

step ai_extract time ~20s cost 0.05
step review by reviewers time ~6min

end approved_direct
end approved_after_review

ai_extract ->
  approved_direct $high_confidence
  review rest
review -> approved_after_review

knob high_confidence 40%..95% = 70%
knob reviewers 2..20 = 8
scenario "Cautious AI": high_confidence = 40%
scenario "Lean team": reviewers = 3

show share end approved_direct
show wait p90 at review
show queue review
show cost per month

labels pt-BR:
  document: Documento
  ai_extract: Extração por IA
  review: Revisão humana
  reviewers: Revisores
  approved_direct: Aprovado direto
  approved_after_review: Aprovado após revisão
  high_confidence: Confiança alta da IA
